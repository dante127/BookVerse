<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- MediatR.Contracts is dependency-free abstractions; it lets IDomainEvent be
         published through the mediator by the SaveChanges dispatcher. -->
    <PackageReference Include="MediatR.Contracts" />
  </ItemGroup>

</Project>
