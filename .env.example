# Copy to .env and fill in real values. Never commit .env.
# docker compose fails fast if a :?-required variable is missing.

# Required. SQL Server SA password (min 8 chars, strong complexity).
MSSQL_SA_PASSWORD=

# Required. JWT signing secret, at least 32 bytes.
JWT_SECRET=

# Optional. Bootstrap admin for Production (roles/permissions are always seeded).
# Leave empty to seed no admin user.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Required. Redis AUTH password (compose wires it into requirepass + API connection string).
REDIS_PASSWORD=

# Optional. SQL Server edition PID sent to MSSQL_PID. Default "Developer" is licensed
# for dev/test only; set "Standard"/"Enterprise" for real production deployments.
MSSQL_PID=Developer

# Optional (PROD-1). Reverse-proxy network whose X-Forwarded-For header is trusted, in CIDR
# form (e.g. the Docker subnet nginx runs on: 172.16.0.0/12). Without it the per-IP rate
# limiter would collapse every caller behind the proxy into one bucket. Leave blank only if
# the API is exposed directly with no proxy in front.
TRUSTED_PROXY_NETWORK=

# Optional (PROD-2). OTLP collector endpoint for metrics (cache hit ratio, worker health,
# HTTP/HTTP-client/runtime meters). When blank, metrics are collected but not exported.
# Standard OTLP env vars (OTEL_EXPORTER_OTLP_HEADERS, ...) are also honored by the exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=
